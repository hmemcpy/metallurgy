#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
intellij_sdk="$HOME/.metallurgyPluginIC/sdk/261.26222.65"

if [[ ! -x "$intellij_sdk/jbr/bin/java" ]]; then
  echo "Pinned IntelliJ JBR is missing; rerun .agents/setup" >&2
  exit 1
fi

if [[ ! -x "$HOME/.local/bin/sbt" ]]; then
  echo "sbt is missing; rerun .agents/setup" >&2
  exit 1
fi

if ! command -v Xvfb >/dev/null; then
  echo "Xvfb is missing; rerun .agents/setup" >&2
  exit 1
fi

echo "Metallurgy orb environment is ready at $repo_root"
